# Copy to .env (the web installer creates it for you). Keep this file private —
# it is blocked from web access by .htaccess and must never be committed.

APP_NAME="SMM Panel"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
# 32 random bytes, base64. Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# NEVER change it after install: it encrypts provider/gateway credentials and 2FA secrets.
APP_KEY=
# Admin panel lives at /ADMIN_PATH — choose something non-obvious.
ADMIN_PATH=admin
FORCE_HTTPS=true
# Comma-separated proxy IPs to trust for X-Forwarded-For (e.g. Cloudflare). Empty = none.
TRUSTED_PROXIES=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

SESSION_NAME=smm_session
SESSION_LIFETIME=7200

# Fallback mail settings (Admin → Email overrides these)
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=

UPLOAD_MAX_BYTES=5242880
# Optional: enables https://example.com/tasks/run/CRON_KEY for URL-only cron. 32+ chars.
CRON_KEY=

# Optional: "Sign in with Google" (see docs/google-login.md). Leave empty to configure
# them in Admin → Settings → Users instead. Values here take precedence. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if your callback URL differs from APP_URL + /auth/google/callback
GOOGLE_REDIRECT_URI=

# Google reCAPTCHA for Login / Sign up (optional; overrides the keys in Admin → Settings → Users).
# Switch it ON in Admin → Settings → Users. Never commit real keys.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
